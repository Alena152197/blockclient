# Strapi CMS base URL (no trailing slash)
# Used by the Nuxt app on both client and server — REQUIRED
NUXT_PUBLIC_STRAPI_URL=https://your-strapi-host.example

# Optional server-only override (falls back to NUXT_PUBLIC_STRAPI_URL)
# STRAPI_URL=https://your-strapi-host.example

# --- Strapi security (делается в панели Strapi, не в этом репо) ---
# Settings → Users & Permissions → Roles → Public → User:
#   снять find и findOne → Save
# Roles → Authenticated → User:
#   снять find (список всех); findOne / me оставить по необходимости → Save
# Проверка: curl -sS -o /dev/null -w "%{http_code}\n" "$NUXT_PUBLIC_STRAPI_URL/api/users"
#   ожидается 403 (не 200 со списком email).

# Site content admins (comma-separated) — SERVER ONLY.
# Do NOT use NUXT_PUBLIC_* for these: they would ship in the browser bundle.
# CONTENT_ADMIN_EMAILS=you@example.com
# CONTENT_ADMIN_USERNAMES=alena
# Legacy names still work on the server only (prefer CONTENT_ADMIN_* above):
# NUXT_PUBLIC_CONTENT_ADMIN_EMAILS=you@example.com
# NUXT_PUBLIC_CONTENT_ADMIN_USERNAMES=alena

# Strapi API Token (Full access) — server-only; used to write About when role lacks update
# STRAPI_API_TOKEN=

# HTTPS deploy hook (GitHub Actions → POST /api/deploy). Same value in GitHub secret DEPLOY_SECRET.
# DEPLOY_SECRET=generate-a-long-random-string

# If photo/text save returns "content must be at most N characters":
# Strapi Admin → Content-Type Builder → About → content → Max length → 5000 (or empty) → Save → restart Strapi
