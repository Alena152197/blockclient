{
  "name": "blockclient",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nuxt 3 frontend for a personal blog with Strapi CMS — posts, comments, settings, and admin console",
  "engines": {
    "node": ">=18.0.0 <=22.x.x"
  },
  "scripts": {
    "clean": "node scripts/rm-output.mjs",
    "clean:all": "node scripts/clean-nuxt.mjs",
    "predev": "node scripts/rm-output.mjs",
    "prebuild": "node scripts/rm-output.mjs",
    "build": "NODE_OPTIONS='--import ./localstorage-ssr-polyfill.mjs' nuxt build",
    "dev": "NODE_OPTIONS='--import ./localstorage-ssr-polyfill.mjs' nuxt dev",
    "generate": "NODE_OPTIONS='--import ./localstorage-ssr-polyfill.mjs' nuxt generate",
    "preview": "NODE_OPTIONS='--import ./localstorage-ssr-polyfill.mjs' nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "NODE_OPTIONS='--import ./localstorage-ssr-polyfill.mjs' node .output/server/index.mjs"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.0",
    "@tailwindcss/vite": "^4.0.0",
    "flowbite": "^2.5.2",
    "form-data": "^4.0.5",
    "markdown-it": "^14.1.0",
    "nuxt": "^3.21.11",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.5.1"
  },
  "overrides": {
    "node-forge": "^1.4.0",
    "form-data": "^4.0.5"
  }
}
